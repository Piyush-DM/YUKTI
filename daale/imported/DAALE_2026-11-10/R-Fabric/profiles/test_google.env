# Gemini 3 Flash (preview) takes the heavy kernels and the adversary; Gemini 2.5 Flash the lighter kernels; each backs up the other.
# Non-secret: the key stays in .env. Per-model limits are in LLM_LIMITS in .env.
DAALE_DEFAULT_MODEL=gemini-2.5-flash
DAALE_ADVERSARY_MODEL=gemini-3-flash-preview
DAALE_ADVERSARY_FALLBACK_MODEL=gemini-2.5-flash
DAALE_FIRST_PRINCIPLES_MODEL=gemini-3-flash-preview
DAALE_EXPANSIONIST_MODEL=gemini-3-flash-preview
DAALE_CONTRARIAN_MODEL=gemini-3-flash-preview
DAALE_ANALYST_MODEL=gemini-2.5-flash
DAALE_OUTSIDER_MODEL=gemini-2.5-flash
DAALE_HISTORIAN_MODEL=gemini-2.5-flash
DAALE_FIRST_PRINCIPLES_FALLBACK_MODEL=gemini-2.5-flash
DAALE_EXPANSIONIST_FALLBACK_MODEL=gemini-2.5-flash
DAALE_CONTRARIAN_FALLBACK_MODEL=gemini-2.5-flash
DAALE_ANALYST_FALLBACK_MODEL=gemini-3-flash-preview
DAALE_OUTSIDER_FALLBACK_MODEL=gemini-3-flash-preview
DAALE_HISTORIAN_FALLBACK_MODEL=gemini-3-flash-preview
