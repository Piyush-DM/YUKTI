{
  "policy_id": "CONTRACT-FORMATION-UNILATERAL",
  "policy_version": "0.1",
  "decision_stage": "contract_formation_approval",
  "decision_states": [
    "ADVANCE",
    "HOLD",
    "REJECT",
    "ESCALATE"
  ],
  "human_authority_required": true,
  "requirements": [
    {
      "requirement_id": "R1",
      "description": "A clear and definite offer was made with intention to be bound.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R2",
      "description": "The offer was accepted by performance of the specified conditions.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R3",
      "description": "Consideration was provided by the offeree.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R4",
      "description": "No notification of acceptance beyond performance was required for this unilateral offer.",
      "mandatory": false,
      "critical": false
    }
  ],
  "rules": [
    {
      "rule_id": "CF100-OFFER-CLARITY",
      "priority": 100,
      "description": "Reject if offer terms are vague or ambiguous.",
      "condition": {
        "metric": "failed_critical_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "REJECT"
    },
    {
      "rule_id": "CF090-ACCEPTANCE-ISSUES",
      "priority": 90,
      "description": "Reject if acceptance was not properly performed.",
      "condition": {
        "metric": "failed_critical_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "REJECT"
    },
    {
      "rule_id": "CF080-NO-CONSIDERATION",
      "priority": 80,
      "description": "Reject if no consideration provided by offeree.",
      "condition": {
        "metric": "failed_critical_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "REJECT"
    },
    {
      "rule_id": "CF070-UNCLEAR-TERMS",
      "priority": 70,
      "description": "Hold if terms are uncertain or ambiguous.",
      "condition": {
        "metric": "unknown_mandatory_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "HOLD"
    },
    {
      "rule_id": "CF060-ALL-SATISFIED",
      "priority": 60,
      "description": "Advance if all critical requirements satisfied.",
      "condition": {
        "metric": "failed_critical_requirements",
        "operator": "eq",
        "value": 0
      },
      "outcome": "ADVANCE"
    },
    {
      "rule_id": "CF000-CONSERVATIVE-FALLBACK",
      "priority": 0,
      "description": "Escalate any valid state not covered by a more specific rule.",
      "condition": {
        "metric": "always",
        "operator": "eq",
        "value": true
      },
      "outcome": "ESCALATE"
    }
  ]
}