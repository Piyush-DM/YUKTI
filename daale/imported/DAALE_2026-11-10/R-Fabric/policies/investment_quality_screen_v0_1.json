{
  "policy_id": "INVESTMENT-QUALITY-SCREEN",
  "policy_version": "0.1",
  "decision_stage": "investment_quality_screen",
  "decision_states": [
    "ADVANCE",
    "HOLD",
    "REJECT",
    "ESCALATE"
  ],
  "human_authority_required": true,
  "requirements": [
    {
      "requirement_id": "R1",
      "description": "The business has a durable competitive position, supported by evidence.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R2",
      "description": "The balance sheet is financially strong: capital or liquidity is adequate and leverage or asset quality is under control.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R3",
      "description": "Management and governance quality are supported by evidence, including how the company handled any recent stress or leadership change.",
      "mandatory": true,
      "critical": true
    },
    {
      "requirement_id": "R4",
      "description": "Material sustainability risks are identified and the company has taken concrete steps on them.",
      "mandatory": true,
      "critical": false
    }
  ],
  "rules": [
    {
      "rule_id": "IQS100-CRITICAL-FAILURE",
      "priority": 100,
      "description": "Reject when supplied evidence establishes failure of a critical requirement.",
      "condition": {
        "metric": "failed_critical_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "REJECT"
    },
    {
      "rule_id": "IQS090-HIGH-CHALLENGE",
      "priority": 90,
      "description": "Escalate when an analyst finding has a high-severity adversarial challenge.",
      "condition": {
        "metric": "high_adversarial_challenges",
        "operator": "gte",
        "value": 1
      },
      "outcome": "ESCALATE"
    },
    {
      "rule_id": "IQS080-HIGH-CONTRADICTION",
      "priority": 80,
      "description": "Escalate when the evidence contains a high-severity unresolved contradiction.",
      "condition": {
        "metric": "high_unresolved_contradictions",
        "operator": "gte",
        "value": 1
      },
      "outcome": "ESCALATE"
    },
    {
      "rule_id": "IQS070-MANDATORY-FAILURE",
      "priority": 70,
      "description": "Hold when a non-critical mandatory requirement is not satisfied.",
      "condition": {
        "metric": "failed_mandatory_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "HOLD"
    },
    {
      "rule_id": "IQS060-MANDATORY-UNKNOWN",
      "priority": 60,
      "description": "Hold when a mandatory requirement cannot be assessed from the evidence.",
      "condition": {
        "metric": "unknown_mandatory_requirements",
        "operator": "gte",
        "value": 1
      },
      "outcome": "HOLD"
    },
    {
      "rule_id": "IQS050-ALL-MANDATORY-SATISFIED",
      "priority": 50,
      "description": "Advance when every mandatory requirement is satisfied and no higher-priority rule applies.",
      "condition": {
        "metric": "all_mandatory_requirements_satisfied",
        "operator": "eq",
        "value": true
      },
      "outcome": "ADVANCE"
    },
    {
      "rule_id": "IQS000-CONSERVATIVE-FALLBACK",
      "priority": 0,
      "description": "Escalate when no other rule applies.",
      "condition": {
        "metric": "always",
        "operator": "eq",
        "value": true
      },
      "outcome": "ESCALATE"
    }
  ]
}
