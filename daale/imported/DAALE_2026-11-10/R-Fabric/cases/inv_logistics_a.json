        "content_hash": "7d8db87cebf4dfd070b190bd909734d15a5c89dcf5b9f41435720ae1ff7c6f4d"
      }
    },
    {
      "evidence_id": "E4",
      "text": "The company's vice chairman and managing director, a pivotal member of management, died unexpectedly. The note states that the company continued to execute well in the period that followed and that management execution has been better than expected.",
      "source": {
        "source_id": "S4",
        "source_type": "DECLARATION",
        "title": "Investment manager's case-study note (management)",
        "collected_at": "2026-11-10T10:00:00Z",
        "document_id": "CS-LOG-A-4",
        "source_uri": "urn:case-study:cs-log-a-4",
        "section": "Management",
