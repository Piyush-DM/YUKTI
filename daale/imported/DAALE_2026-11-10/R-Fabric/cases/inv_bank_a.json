{
  "case_id": "INV-BANK-A",
  "decision_stage": "investment_quality_screen",
  "decision_question": "Does Bank A pass the quality screen for inclusion in a long-term India-focused portfolio?",
  "claims": [
    {
      "claim_id": "C1",
      "text": "The company has a durable competitive position."
    },
    {
      "claim_id": "C2",
      "text": "The company's financial position is strong."
    },
    {
      "claim_id": "C3",
      "text": "Management and governance are of good quality."
    }
  ],
  "evidence": [
    {
      "evidence_id": "E1",
      "text": "Bank A is the largest private-sector bank in its market by assets. It has more than 7,500 branches and serves tens of millions of retail, small-business and corporate customers.",
      "source": {
        "source_id": "S1",
        "source_type": "DECLARATION",
