{
  "case_id": "INV-LOGISTICS-B",
  "decision_stage": "investment_quality_screen",
  "decision_question": "Does Company B pass the quality screen for inclusion in a long-term India-focused portfolio?",
  "claims": [
    {
      "claim_id": "C1",
      "text": "The company has a durable competitive position."
    },
    {
      "claim_id": "C2",
      "text": "The company's financial position is strong."
    },
    {
      "claim_id": "C3",
      "text": "Management and governance are of good quality."
    }
  ],
  "evidence": [
    {
      "evidence_id": "E1",
      "text": "Company B is a leading integrated oil, gas and chemical logistics company in its market, with terminals at major ports and a position as a top private importer and handler of liquefied petroleum gas. It was early to establish itself in several key ports.",
      "source": {
        "source_id": "S1",
