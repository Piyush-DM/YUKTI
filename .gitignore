# Python bytecode and interpreter caches.
__pycache__/
*.py[cod]
*$py.class

# Local test and analysis output.
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local packaging/build output.
*.egg-info/
build/
dist/

# Node dependency trees. Restored locally with `npm install`; never committed.
node_modules/

# Keep the placeholders that document where dependencies belong.
!website/node_modules/
website/node_modules/*
!website/node_modules/README.md
!film/node_modules/
film/node_modules/*
!film/node_modules/README.md

# Local dev-server logs.
*.log

# Generated report output. Keep the note that documents the conventions.
# See reports/README.md.
reports/*
!reports/README.md

# Remotion render output and bundle cache.
film/out/
.remotion/

# Local virtual environments and machine-specific environment files.
.venv/
venv/
env/
.env
.env.*
